# .env.example - copy to .env and fill in (never commit .env)
# GROQ_API_KEY only when stt.provider = "groq" in lowass.toml
# GROQ_API_KEY=gsk_...

# Your LiteLLM proxy (OpenAI-compatible) and its key
LITELLM_BASE_URL=https://litellm.example.com/v1
LITELLM_API_KEY=sk-...

# Token of your mcphub (the URL of each project is in lowass.toml [projects.<key>])
MCPHUB_TOKEN=...
